<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Frame name="GwEssencePointTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="background" file="Interface\AddOns\GW2_UI\textures\altpower\evoker.png">
                    <Size x="32" y="32"/>
                    <TexCoords left="0.5" right="1" top="0" bottom="1"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="EssenceFilling" setAllPoints="true" hidden="true">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="EssenceIcon" file="Interface\AddOns\GW2_UI\textures\altpower\evoker.png">
                            <Size x="32" y="32"/>
                            <TexCoords left="0" right="0.5" top="0" bottom="1"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Cooldown parentKey="Swipe" hideCountdownNumbers="true" drawEdge="false" drawBling="false">
                        <Size x="26" y="26"/>
                        <Anchors>
                            <Anchor point="CENTER"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self:SetSwipeTexture("Interface/CHARACTERFRAME/TempPortraitAlphaMask");
                                self:SetSwipeColor(0, 0, 0, 0.75);
                            </OnLoad>
                        </Scripts>
                    </Cooldown>
                </Frames>
            </Frame>

            <Frame parentKey="EssenceFull" setAllPoints="true" hidden="true">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="EssenceIconActive" file="Interface\AddOns\GW2_UI\textures\altpower\evoker.png">
                            <Size x="32" y="32"/>
                            <TexCoords left="0" right="0.5" top="0" bottom="1"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture parentKey="Flash" alphaMode="ADD" alpha="0" file="Interface\AddOns\GW2_UI\textures\altpower\evoker.png">
                            <Size x="32" y="32"/>
                            <TexCoords left="0" right="0.5" top="0" bottom="1"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Animations>
                    <AnimationGroup parentKey="FlashAnim" looping="NONE" setToFinalAlpha="true">
                        <Alpha childKey="Flash" duration=".15" order="1" fromAlpha="0" toAlpha=".9"/>
                        <Scale childKey="Flash" duration=".15" order="1" fromScaleX="1" fromScaleY="1" toScaleX="1.25" toScaleY="1.25">
                            <Origin point="CENTER"/>
                        </Scale>
                        <Alpha childKey="Flash" duration=".45" order="2" fromAlpha=".9" toAlpha="0"/>
                        <Scale childKey="Flash" duration=".45" order="2" fromScaleX="1.25" fromScaleY="1.25" toScaleX="1" toScaleY="1">
                            <Origin point="CENTER"/>
                        </Scale>
                    </AnimationGroup>
                </Animations>
            </Frame>

            <Frame parentKey="EssenceDepleting" setAllPoints="true" hidden="true">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="EssenceIcon" file="Interface\AddOns\GW2_UI\textures\altpower\evoker.png">
                            <Size x="32" y="32"/>
                            <TexCoords left="0" right="0.5" top="0" bottom="1"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Animations>
                    <AnimationGroup parentKey="AnimIn" looping="NONE">
                        <Alpha childKey="EssenceIcon" duration=".4" order="1" fromAlpha="1" toAlpha="0"/>
                        <Scale childKey="EssenceIcon" duration=".4" order="1" fromScaleX="1" fromScaleY="1" toScaleX="0.75" toScaleY="0.75">
                            <Origin point="CENTER"/>
                        </Scale>
                        <Scripts>
                            <OnFinished>
                                self:GetParent():Hide();
                            </OnFinished>
                        </Scripts>
                    </AnimationGroup>
                </Animations>
                <Scripts>
                    <OnShow>
                        self.AnimIn:Restart();
                    </OnShow>
                </Scripts>
            </Frame>
        </Frames>
    </Frame>

</Ui>
